# 默认：文本文件在仓库中统一使用 LF
* text=auto eol=lf

*.java   text eol=lf
*.xml    text eol=lf
*.properties text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.sql    text eol=lf
*.md     text eol=lf
*.vue    text eol=lf
*.js     text eol=lf
*.json   text eol=lf
*.html   text eol=lf
*.scss   text eol=lf
*.css    text eol=lf
*.env    text eol=lf
.env.*   text eol=lf

# Windows 脚本保留 CRLF
*.bat    text eol=crlf
*.cmd    text eol=crlf

# 二进制
*.jar    binary
*.class  binary
*.ttf    binary
*.pdf    binary
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.svg    binary
